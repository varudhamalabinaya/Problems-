import java.util.*;
class Main {
    public static void main(String[] args) {
       Scanner sc=new Scanner(System.in);
       int n = sc.nextInt();
       int arr[]=new int[n];
       for (int i=0;i<n;i++){
           arr[i]=sc.nextInt();
       }
        int mid=arr.length/2;
        Arrays.sort(arr,0,mid);
         Arrays.sort(arr,mid,arr.length);
        for(int i=0;i<mid;i++){
            System.out.print(arr[i]+" ");
        }
        for(int i=n-1;i>=mid;i--){
            System.out.print(arr[i]+" ");
        }
    }
    
}
